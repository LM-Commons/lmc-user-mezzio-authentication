{
  "name": "lm-commons/lmc-user-mezzio-authentication",
  "description": "lmc-user adapter for mezzio-authentication",
  "license": "BSD-3-Clause",
  "version": "1.0.0",
  "authors": [
    {
      "name": "Eric Richer",
      "email": "eric.richer@vistoconsulting.com"
    }
  ],
  "require": {
    "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
    "laminas/laminas-authentication": "^2.0",
    "laminas/laminas-eventmanager": "^3.14",
    "lm-commons/lmc-user-repository": "1.0.x-authenticate-dev",
    "mezzio/mezzio-authentication": "^1.10",
    "mezzio/mezzio-session": "^1.16",
    "psr/container": "^2.0"
  },
  "require-dev": {
    "laminas/laminas-coding-standard": "^3.1",
    "phpunit/phpunit": "^11.5 || ^12.1",
    "psalm/plugin-phpunit": "^0.19",
    "vimeo/psalm": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "Lmc\\User\\Authentication\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LmcTest\\User\\Authentication\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2.99"
    }
  },
  "extra": {
    "laminas": {
      "config-provider": "Lmc\\User\\Authentication\\ConfigProvider"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@test"
    ],
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-clover ./build/logs/clover.xml",
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "test-coverage-html": "phpunit --coverage-html ./build/html",
    "static-analysis": "psalm --shepherd --stats"
  },
  "repositories": [
    {
      "type": "git",
      "url": "c:/lm-commons/lmc-user-repository"
    }
  ]
}
