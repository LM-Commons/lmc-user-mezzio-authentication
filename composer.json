{
  "name": "lm-commons/lmc-user-mezzio-authentication",
  "description": "lmc-user adapter for mezzio-authentication",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Eric Richer",
      "email": "eric.richer@vistoconsulting.com"
    }
  ],
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "laminas/laminas-authentication": "^2.13",
    "laminas/laminas-eventmanager": "^3.14",
    "laminas/laminas-session": "^2.12",
    "lm-commons/lmc-user-repository": "^1.0",
    "mezzio/mezzio-session": "^1.16"
  },
  "require-dev": {
    "laminas/laminas-coding-standard": "^3.1",
    "phpunit/phpunit": "^12.5.22",
    "psalm/plugin-phpunit": "^0.19.5",
    "vimeo/psalm": "^6.16"
  },
  "autoload": {
    "psr-4": {
      "Lmc\\User\\Authentication\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LmcTest\\User\\Authentication\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.3.99"
    }
  },
  "extra": {
    "laminas": {
      "config-provider": "Lmc\\User\\Authentication\\ConfigProvider"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@test"
    ],
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-clover ./build/logs/clover.xml",
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "test-coverage-html": "phpunit --coverage-html ./build/html",
    "static-analysis": "psalm --shepherd --stats",
    "static-analysis-update-baseline": "psalm --shepherd --stats --update-baseline"
  }
}
